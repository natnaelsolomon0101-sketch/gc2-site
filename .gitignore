# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# QA screenshots. The audit evidence that matters is textual (CRITIQUE.md,
# FIXES.md, summary.json, checklist.md, killist.txt) and stays tracked; the
# PNGs are ~96MB per full run and do not belong in history.
docs/qa/**/screens/
docs/baseline/*.png
docs/screens/
