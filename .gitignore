# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# Agent worktrees — transient checkouts that each carry their own node_modules
# (~580MB apiece; twelve of them filled a 228GB disk to 100%).
.claude/worktrees/
.design-audit/

# QA artifacts. Reproducible with `npm run qa`; the raw Lighthouse traces are
# ~9,900 lines each and buried the real diff on a previous PR.
docs/qa/**/lighthouse-*.json
docs/qa/**/screens/
docs/screens/
# v4 viewport matrix: raw per-shot PNGs are regenerated on demand; keep sheets + matrix.json
docs/v4/shots/*/*.png
docs/v4/shots/*/**/*.png
!docs/v4/shots/*/sheets/*.png
!docs/v4/shots/baseline/*.png
!docs/v4/shots/foundation/*.png
